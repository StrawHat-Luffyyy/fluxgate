# Copy to .env (never commit the real one) and export before running `python consumer.py`.
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=gateway.traffic.logs
KAFKA_DLQ_TOPIC=gateway.traffic.dlq
KAFKA_GROUP_ID=fluxgate-ai-workers
ALERT_ENDPOINT=http://localhost:3000/internal/alerts
# REQUIRED. Must equal the gateway's INTERNAL_ALERT_SECRET. The service refuses to start without it.
INTERNAL_ALERT_SECRET=
MODEL_DIR=models
# Leave empty to use the version named in models/LATEST.
MODEL_VERSION=
HEALTH_PORT=8090
LOG_LEVEL=INFO
RANGE_GUARD_MULTIPLIER=10   # 0 disables the range guard
