# Copy to .env. Every value below is the development default unless marked as
# required in production. The gateway refuses to start in production with the
# built-in development secrets.

NODE_ENV=development
PORT=3000
# LOG_LEVEL=debug

DATABASE_URL=postgresql://fluxgate:fluxgate@localhost:5432/fluxgate
REDIS_URL=redis://localhost:6379
KAFKA_BROKER=localhost:19092
KAFKA_TOPIC=gateway.traffic.logs

# Required in production. Generate each with: openssl rand -hex 32
# JWT_SECRET=
# INTERNAL_ALERT_SECRET=     (must match ai-service)
# SECRETS_ENCRYPTION_KEY=

# Bearer token for GET /metrics. Without it, /metrics is open.
# METRICS_TOKEN=

CORS_ORIGINS=http://localhost:3001
# COOKIE_SECURE=true         (defaults to true in production)
# TRUST_PROXY=true           (only behind a proxy that appends X-Forwarded-For)

# Disables SSRF protection, for local upstreams and webhook receivers. Refused
# in production unless FLUXGATE_DEMO_MODE is also set.
# ALLOW_PRIVATE_TARGETS=true
UPSTREAM_TIMEOUT_MS=30000

WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_BACKOFF_MS=2000
WEBHOOK_TIMEOUT_MS=5000

# OTEL_ENABLED=true
# OTLP_ENDPOINT=http://localhost:4318/v1/traces
# SENTRY_DSN=
