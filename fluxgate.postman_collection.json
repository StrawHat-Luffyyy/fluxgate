{
  "info": {
    "_postman_id": "e8fb2c31-4e4b-4c07-b3f4-00d867c00e12",
    "name": "FluxGate API Gateway",
    "description": "Comprehensive Postman collection for the FluxGate Core API Gateway routes. Includes automated environment variable extraction for Tenant IDs and API Keys.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "GET Health Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Retrieve the system uptime, state, and status timestamp."
          },
          "response": []
        },
        {
          "name": "GET Prometheus Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "metrics"
              ]
            },
            "description": "Scrape raw Prometheus metrics (Request counters, response times, latency histograms)."
          },
          "response": []
        },
        {
          "name": "GET Test Rate Limit",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/test-rate-limit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "test-rate-limit"
              ]
            },
            "description": "Test verification of rate limits and secure auth filters using the rate limit test route."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Onboarding",
      "item": [
        {
          "name": "POST Create Tenant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.data && response.data[0]) {",
                  "    pm.collectionVariables.set(\"tenantId\", response.data[0].id);",
                  "    console.log(\"Captured tenantId: \", response.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Enterprise Tenant A\",\n  \"plan\": \"enterprise\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tenants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tenants"
              ]
            },
            "description": "Creates a new tenant and automatically stores the returned Tenant UUID inside the collection variables."
          },
          "response": []
        },
        {
          "name": "POST Generate API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.apiKey) {",
                  "    pm.collectionVariables.set(\"apiKey\", response.apiKey);",
                  "    console.log(\"Captured apiKey: \", response.apiKey);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{tenantId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/keys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "keys"
              ]
            },
            "description": "Generates a high-entropy API key for the newly created tenant ID, automatically updating the collection's auth `apiKey` variable."
          },
          "response": []
        },
        {
          "name": "GET Auth Protected Route",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/keys/protected",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "keys",
                "protected"
              ]
            },
            "description": "Test verification of the generated bearer API key against rate limits and secure auth filters."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin Rules",
      "item": [
        {
          "name": "POST Register Route Mapping",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pathPrefix\": \"/posts\",\n  \"targetUrl\": \"https://jsonplaceholder.typicode.com/posts\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/routes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "routes"
              ]
            },
            "description": "Registers an upstream proxy mapping (e.g. `/posts` -> JSONPlaceholder `/posts`) for the authenticated tenant context."
          },
          "response": []
        },
        {
          "name": "GET List Route Mappings",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/routes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "routes"
              ]
            },
            "description": "Retrieves the list of registered proxy route mappings for the authenticated tenant context."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Proxy Gateway",
      "item": [
        {
