                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/gateway/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "gateway",
                "posts",
                "1"
              ]
            },
            "description": "Proxies a GET request through the gateway to fetch details for post ID 1."
          },
          "response": []
        },
        {
          "name": "POST Gateway Forwarding",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"FluxGate Dynamic Post\",\n  \"body\": \"This body is successfully piped through the reverse proxy stream.\",\n  \"userId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/gateway/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "gateway",
                "posts"
              ]
            },
            "description": "Proxies a POST request along with its payload to create a new resource on the upstream target."
          },
          "response": []
        },
        {
          "name": "PUT Gateway Forwarding",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"title\": \"Updated Post Title\",\n  \"body\": \"This updated body is piped through the reverse proxy stream.\",\n  \"userId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/gateway/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "gateway",
                "posts",
                "1"
              ]
            },
            "description": "Proxies a PUT request along with its payload to update the resource with ID 1 upstream."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Internal Alerting",
